---
import { fmt, categoryOf, catLabel, excerpt } from '../lib';
const { posts, showCategory = true } = Astro.props;
---
<ul class="list">
  {posts.map((p) => (
    <li data-tags={p.data.tags.join(' ')}><a href={`/posts/${p.id}/`} class="row">
      <div class="row-body">
        <div class="row-meta">{showCategory && <span class="chip">{catLabel(categoryOf(p))}</span>}<time>{fmt(p.data.date).replaceAll('-', '. ')}</time></div>
        <h3>{p.data.title}</h3>
        <p>{excerpt(p)}</p>
      </div>
      <div class="row-thumb">{p.data.thumbnailImage ? <img src={p.data.thumbnailImage} alt="" loading="lazy" class:list={[{ icon: p.data.thumbnailImage.endsWith('.svg') || p.data.thumbnailImage.includes('avatar') }]} /> : <span>{p.data.title[0]}</span>}</div>
    </a></li>
  ))}
</ul>
