---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getPosts, CATEGORIES, tags, tagLabel } from '../../lib';
export async function getStaticPaths() {
  const all = await getPosts();
  return CATEGORIES.map((c) => ({ params: { cat: c.slug }, props: { all, info: c } }));
}
const { all, info } = Astro.props;
const posts = all.filter((p) => p.data.category === info.slug);
const topicTags = tags(posts);
---
<Base title={info.label} active={info.slug}>
  <header class="page-head"><p>카테고리</p><h1>{info.label}</h1><span>{info.description}</span></header>
  <div class="layout">
    <section data-filter-root>
      {topicTags.length > 1 && (
        <div class="filter" role="group" aria-label="주제로 거르기">
          <button type="button" data-tag="" aria-pressed="true">전체 <small>{posts.length}</small></button>
          {topicTags.map(([t, n]) => <button type="button" data-tag={t} aria-pressed="false">{tagLabel(t)} <small>{n}</small></button>)}
        </div>
      )}
      {posts.length ? <PostList posts={posts} showCategory={false} /> : <p class="empty">아직 글이 없어요.</p>}
    </section>
    <Sidebar posts={all} active={info.slug} />
  </div>
</Base>
<script>
  const root = document.querySelector<HTMLElement>('[data-filter-root]');
  const buttons = [...(root?.querySelectorAll<HTMLButtonElement>('[data-tag]') ?? [])];
  const apply = (tag: string) => {
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.tag === tag)));
    root?.querySelectorAll<HTMLElement>('.list > li').forEach((li) => {
      li.hidden = !!tag && !(li.dataset.tags ?? '').split(' ').includes(tag);
    });
    const url = new URL(location.href);
    tag ? url.searchParams.set('tag', tag) : url.searchParams.delete('tag');
    history.replaceState(null, '', url);
  };
  buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.tag ?? '')));
  const initial = new URLSearchParams(location.search).get('tag');
  if (initial && buttons.some((b) => b.dataset.tag === initial)) apply(initial);
</script>
