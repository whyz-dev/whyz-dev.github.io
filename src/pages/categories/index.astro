---
import Base from '../../layouts/Base.astro';
import { getPosts, CATEGORIES, fmt, catHref } from '../../lib';
const posts = await getPosts();
---
<Base title="카테고리">
  <header class="page-head"><h1>카테고리</h1><span>글의 성격별로 모아봤어요.</span></header>
  <div class="cat-grid">
    {CATEGORIES.map((c) => {
      const list = posts.filter((p) => p.data.category === c.slug);
      return (
        <section class="cat-card">
          <header><a href={catHref(c.slug)}><h2>{c.label}</h2></a><small>{list.length}개</small></header>
          <p class="cat-desc">{c.description}</p>
          {list.length
            ? <ul>{list.slice(0, 5).map((p) => <li><a href={`/posts/${p.id}/`}><span>{p.data.title}</span><time>{fmt(p.data.date)}</time></a></li>)}</ul>
            : <p class="empty small">아직 글이 없어요.</p>}
          {list.length > 0 && <a class="more" href={catHref(c.slug)}>전체 보기 →</a>}
        </section>
      );
    })}
  </div>
</Base>
