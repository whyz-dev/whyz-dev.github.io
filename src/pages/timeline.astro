---
import Base from '../layouts/Base.astro';
import { sortedTimeline, periodOf as period, yearOf } from '../data/timeline';
import { tagLabel, tagHref } from '../lib';

const items = sortedTimeline();
const years = [...new Set(items.map(yearOf))];

---
<Base title="타임라인" active="timeline" description="whyz의 활동 타임라인">
  <header class="page-head tl-head">
    <h1>활동 타임라인</h1>
  </header>

  <div class="tl-filter filter" role="group" aria-label="종류로 거르기">
    <button type="button" data-type="" aria-pressed="true">전체</button>
    <button type="button" data-type="contest" aria-pressed="false">대회</button>
    <button type="button" data-type="project" aria-pressed="false">프로젝트</button>
  </div>

  <div class="tl">
    {years.map((y) => (
      <section class="tl-year" data-year>
        <h2 class="tl-year-label">{y}</h2>
        <ol class="tl-list">
          {items.filter((i) => yearOf(i) === y).map((i) => (
            <li class="tl-item" data-type={i.type}>
              <span class:list={['tl-dot', { award: i.award }]} aria-hidden="true"></span>
              <article class:list={['tl-card', { 'has-img': i.image }]}>
                <div class="tl-body">
                <div class="tl-meta">
                  <span class:list={['chip', { 'chip-muted': i.type === 'project' }]}>{i.type === 'contest' ? '대회' : '프로젝트'}</span>
                  <time>{period(i)}</time>
                  {i.org && <span class="tl-org">{i.org}</span>}
                </div>
                <h3>{i.title}</h3>
                {i.result && <p class:list={['tl-result', { award: i.award }]}>{i.award && <span aria-hidden="true">🏅 </span>}{i.result}</p>}
                <p class="tl-summary">{i.summary}</p>
                {i.points && <ul class="tl-points">{i.points.map((p) => <li>{p}</li>)}</ul>}
                <div class="tl-foot">
                  {i.tags && <div class="tags">{i.tags.map((t) => <a href={tagHref(t)}>{tagLabel(t)}</a>)}</div>}
                  <div class="tl-links">
                    {i.team && <span class="tl-team">{i.team}</span>}
                    {i.post && <a href={`/posts/${i.post}/`}>후기 읽기 →</a>}
                    {i.repo && <a href={i.repo} target="_blank" rel="noopener">GitHub ↗</a>}
                    {i.link && <a href={i.link} target="_blank" rel="noopener">대회 페이지 ↗</a>}
                  </div>
                </div>
                </div>
                {i.image && <a class:list={['tl-img', { contain: i.imageFit === 'contain' }]} href={i.image} target="_blank" rel="noopener"><img src={i.image} alt={i.imageAlt ?? ''} loading="lazy" /></a>}
              </article>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</Base>
<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.tl-filter [data-type]')];
  buttons.forEach((b) => b.addEventListener('click', () => {
    const t = b.dataset.type ?? '';
    buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    document.querySelectorAll<HTMLElement>('.tl-item').forEach((li) => { li.hidden = !!t && li.dataset.type !== t; });
    document.querySelectorAll<HTMLElement>('[data-year]').forEach((s) => { s.hidden = !s.querySelector('.tl-item:not([hidden])'); });
  }));
</script>
