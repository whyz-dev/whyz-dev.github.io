---
import Base from '../layouts/Base.astro';
import { PROFILE, LINKS, EDUCATION, ACTIVITIES, SKILLS } from '../data/profile';
import { sortedTimeline, periodOf } from '../data/timeline';
import { getAnnouncements } from '../lib';

// 상단 프로필은 홈 배너의 bio(kind: profile) 파일을 그대로 사용해요
const bio = (await getAnnouncements()).find((a) => a.data.kind === 'profile')?.data;
const bioTitle = bio?.title ?? `안녕하세요, ${PROFILE.name}입니다.`;
const bioImage = bio?.image ?? '/img/profile.png';
const bioBadges = bio?.badges ?? [];

const highlights = sortedTimeline().filter((i) => i.award || i.end === 'now').slice(0, 5);
const linkList = [
  { key: 'github', label: 'GitHub', href: LINKS.github },
  { key: 'dacon', label: 'Dacon', href: LINKS.dacon },
  { key: 'kaggle', label: 'Kaggle', href: LINKS.kaggle },
  { key: 'linkedin', label: 'LinkedIn', href: LINKS.linkedin },
].filter((l) => l.href);
const emails = LINKS.emails.filter(Boolean);
---
<Base title="소개" active="about" description={`${PROFILE.name} — ${PROFILE.headline}`}>
  <div class="about">
    <header class="about-hero">
      <div class="about-hero-text">
        <span class="chip">{bio?.label ?? 'About'}</span>
        <h1>{bioTitle}</h1>
        {PROFILE.intro.map((p) => <p class="about-intro">{p}</p>)}
        <nav class="about-links" aria-label="링크">
          {linkList.map((l) => <a href={l.href} target="_blank" rel="noopener" class="about-link">{l.label} ↗</a>)}
        </nav>
        {emails.length > 0 && (
          <ul class="about-mail" aria-label="메일">
            {emails.map((m) => <li><a href={`mailto:${m}`}><span aria-hidden="true">✉</span>{m}</a></li>)}
          </ul>
        )}
      </div>
      <div class="feature-art feature-profile about-art" aria-hidden="true">
        <span class="fp-blob fp-b1"></span><span class="fp-blob fp-b2"></span><span class="fp-blob fp-b3"></span>
        <span class="fp-ring fp-r1"></span><span class="fp-ring fp-r2"></span>
        <img class="fp-avatar" src={bioImage} alt="" />
        {bioBadges.map((b, k) => <span class={`fp-badge fp-badge-${k % 4}`}>{b}</span>)}
      </div>
    </header>

    <section class="about-sec">
      <h2>학력</h2>
      <ul class="about-aff">
        {EDUCATION.map((e) => (
          <li>
            <span class="about-aff-mark" aria-hidden="true">{e.logo ? <img src={e.logo} alt="" /> : e.name[0]}</span>
            <div><b>{e.name}</b><small>{[e.detail, e.period].filter(Boolean).join(' · ')}</small></div>
          </li>
        ))}
      </ul>
    </section>

    <section class="about-sec">
      <h2>소속·활동</h2>
      <ul class="about-acts">
        {ACTIVITIES.map((x) => (
          <li>
            <span class="about-aff-mark" aria-hidden="true">{x.logo ? <img src={x.logo} alt="" /> : x.name[0]}</span>
            <div class="about-act-body"><b>{x.name}</b>{x.role && <span class="about-role">{x.role}</span>}{x.where && <small>{x.where}</small>}</div>
            <time>{x.period}</time>
          </li>
        ))}
      </ul>
    </section>

    <section class="about-sec">
      <div class="about-sec-head"><h2>주요 활동</h2><a href="/timeline/">전체 타임라인 →</a></div>
      <ul class="about-hl">
        {highlights.map((i) => (
          <li>
            <div><b>{i.title}</b><small>{i.org ? `${i.org} · ` : ''}{periodOf(i)}</small></div>
            {i.result && <em class:list={[{ award: i.award }]}>{i.result}</em>}
          </li>
        ))}
      </ul>
    </section>

    <section class="about-sec">
      <h2>기술 스택</h2>
      <dl class="about-skills">
        {SKILLS.map((g) => (<div><dt>{g.group}</dt><dd>{g.items.map((s) => <span>{s}</span>)}</dd></div>))}
      </dl>
    </section>
  </div>
</Base>
