---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getPosts, CATEGORIES, catHref, tagLabel } from '../../lib';
export async function getStaticPaths() {
  const all = await getPosts();
  const tags = [...new Set(all.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({ params: { tag }, props: { all } }));
}
const { tag } = Astro.params; const { all } = Astro.props;
const posts = all.filter((p) => p.data.tags.includes(tag));
const groups = CATEGORIES.map((c) => ({ ...c, posts: posts.filter((p) => p.data.category === c.slug) })).filter((g) => g.posts.length);
---
<Base title={tagLabel(tag)} active="tags">
  <header class="page-head"><p>주제</p><h1>{tagLabel(tag)}</h1><span>{posts.length}개의 글 · {groups.map((g) => `${g.label} ${g.posts.length}`).join(' · ')}</span></header>
  <div class="layout">
    <section>
      {groups.map((g) => (
        <div class="group">
          <h2 class="group-title"><a href={`${catHref(g.slug)}?tag=${tag}`}>{g.label}</a><small>{g.posts.length}</small></h2>
          <PostList posts={g.posts} showCategory={false} />
        </div>
      ))}
    </section>
    <Sidebar posts={all} />
  </div>
</Base>
