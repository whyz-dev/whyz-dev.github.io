---
import '../styles/global.css';
import { CATEGORIES, catHref } from '../lib';
const { title, description = 'whyz의 개발 블로그', active = null } = Astro.props;
const full = title ? `${title} · whyz` : 'whyz.dev';
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{full}</title><meta name="description" content={description} />
  <link rel="icon" href="/favicon.png" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
</head>
<body>
  <header class="header">
    <div class="container header-inner">
      <a href="/" class="logo"><img src="/img/avatar.png" alt="" width="26" height="26" /><b>whyz<span>.dev</span></b></a>
      <nav class="tabs" aria-label="카테고리">
        <a href="/" class:list={[{ on: active === 'all' }]}>전체</a>
        {CATEGORIES.map((c) => <a href={catHref(c.slug)} class:list={[{ on: active === c.slug }]}>{c.label}</a>)}
      </nav>
      <nav class="util"><a href="/about/" class:list={["keep", { on: active === 'about' }]}>소개</a><a href="/timeline/" class:list={["keep", { on: active === 'timeline' }]}>타임라인</a><a href="/tags/" class:list={[{ on: active === 'tags' }]}>주제</a><a href="https://github.com/whyz-dev" class="btn">GitHub</a></nav>
    </div>
  </header>
  <main class="container"><slot /></main>
  <footer class="footer"><div class="container footer-inner"><span>© {new Date().getFullYear()} whyz</span><a href="https://github.com/whyz-dev">github.com/whyz-dev</a></div></footer>
</body>
</html>
